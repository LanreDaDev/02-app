# Template only — every value here is a placeholder. Real values go in
# .env.local (gitignored) and in the Vercel dashboard.
#
# NOTE: an earlier version of this file contained real AWS keys and was
# committed. Scrubbing it here does not remove them from git history — rotate
# the old key rather than relying on this file being clean.

# ============================================================================
# Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the client, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# AWS S3 — original photos, reframed stills, final rendered video
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=olade-videos

# ============================================================================
# Compute service (Lightsail)
# ============================================================================
# Public HTTPS origin of the FastAPI service. No trailing slash.
VIDEO_SERVICE_URL=https://api.your-domain.com

# Shared secret, both directions: Vercel authenticates to /generate with it, and
# workers authenticate their webhook callbacks with it. Must equal WEBHOOK_SECRET
# in the service env. Generate with: openssl rand -hex 32
GENERATION_WEBHOOK_SECRET=

# ============================================================================
# Mux — working clips in the editor, and the final render's streaming copy
# ============================================================================
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# From the Mux dashboard's webhook settings. Without it /api/mux/webhook rejects
# every callback and clips never get a playback ID.
MUX_WEBHOOK_SECRET=

# Which progressive MP4 rendition to play. Must match MUX_STATIC_RENDITION on


MUX_MP4_RENDITION=highest

# ============================================================================
# Token economics (1 token = $0.01)
# ============================================================================
# Price is per SECOND of generated video, not per clip: 100 tokens/sec means a
# 4s clip is 400 and a 6s clip is 600. The two reframes are a fixed cost either
# way, so longer clips amortise them slightly better.
#
# TOKENS_PER_CLIP is retained until the slot model lands, where duration becomes
# a per-slot choice and this becomes TOKENS_PER_SECOND.
TOKENS_PER_CLIP=400
SIGNUP_GRANT_TOKENS=800

# Reserved per clip against the daily ceiling, reconciled to actual on
# completion. Not a price, and not the real cost — it is deliberately the WORST
# case, so a burst of expensive clips can't overshoot the ceiling.
#
# Worst case for a 4s two-frame clip:
#   4 x 4K image generations (2 frames, each may take a correction retry) $0.96
#   Veo 4s @ $0.42/sec                                                    $1.68
#                                                                         -----
#                                                                         $2.64
#
# NOTE ON $0.42/sec. Veo itself bills $0.20/sec. The rest is deliberate: it
# stands in for the infrastructure a clip actually consumes and that nobody has
# measured yet — Lightsail, S3 storage and egress, Mux encoding and delivery,
# Lambda renders, Vercel, Supabase. Do NOT "correct" this to 0.20 without
# replacing it with a real fully-loaded figure; the padding is the only thing
# currently accounting for serving costs.
#
# Once duration is per-slot this becomes a formula rather than a constant:
#   reserve = 0.96 + (duration_seconds * 0.42)
#     4s $2.64   6s $3.48   8s $4.32
# A flat value under-reserves anything longer than 4s.
CLIP_USD_ESTIMATE=3.00

# Hard daily spend cap. Reads reserved_usd, so a parallel burst can't overshoot.
# Leave unset/0 to disable the breaker entirely.
DAILY_SPEND_CEILING_USD=500

MAX_GENERATIONS_PER_HOUR=20

# ============================================================================
# Upload limits
# ============================================================================
MAX_IMAGES_PER_PROJECT=50
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp

# ============================================================================
# Stripe
# ============================================================================
# All prices are USD.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_STARTER=price_xxx           # 800 tokens, $10
STRIPE_PRICE_STANDARD=price_xxx          # 8,000 tokens, $80
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_STANDARD=price_xxx

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Remotion Lambda — renders the composition the user edited
# ============================================================================
# Deploy with:
#   npx remotion lambda functions deploy
#   npx remotion lambda sites create lib/remotion/index.tsx --site-name=olade
# The first prints the function name, the second the serve URL.
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_AWS_REGION=us-east-1

# Optional but recommended: signs the render-complete callback.
# Generate with: openssl rand -hex 32
REMOTION_WEBHOOK_SECRET=

# Bucket Remotion writes renders to (remotionlambda-<region>-<hash>).
# Only needed if a render returns a bare key rather than a full URL.
REMOTION_S3_BUCKET=


# How many Lambdas a single render may fan out across. Remotion otherwise picks
# a split tuned for speed and trips "AWS Concurrency limit reached" on accounts
# with the default low concurrent-execution quota. Raise once that quota is.
REMOTION_MAX_LAMBDAS=3

# Set to false to close the shop entirely — no checkout sessions, buy buttons
# hidden. Use this while Stripe is still on TEST keys: the test card 4242… is
# public, so a test-mode checkout on a live site lets anyone mint real tokens.
NEXT_PUBLIC_PURCHASES_ENABLED=true

# Allows test-mode Stripe events to grant tokens. Leave unset in production.
# The webhook otherwise ignores any event with livemode=false, which is the
# backstop if the kill switch above is ever forgotten.
# STRIPE_ALLOW_TEST_MODE=true
