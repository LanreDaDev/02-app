# Copy to deploy/production.env, fill in, then: bash deploy/vercel-env.sh
# deploy/production.env is gitignored. Never commit it.
#
# Ordered by where you get each value, so you can work through one dashboard at
# a time rather than jumping between six.

# ── Supabase → Settings → API ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key. Bypasses row-level security — server-side only, and it
# must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── AWS → IAM user "olade-vercel" ────────────────────────────────────────────
# Needs S3 GetObject/PutObject on the bucket AND the Remotion user policy
# (`npx remotion lambda policies user`) — this identity invokes the render.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=olade-videos

# ── Your own infrastructure ──────────────────────────────────────────────────
VIDEO_SERVICE_URL=https://api.olade.com
NEXT_PUBLIC_APP_URL=https://app.olade.com

# Shared secret with the Lightsail box. Generate ONCE with `openssl rand -hex 32`
# and paste the SAME value into the box's WEBHOOK_SECRET. A mismatch fails
# silently after a clip is already generated and paid for.
GENERATION_WEBHOOK_SECRET=

# ── Mux → Settings → Access Tokens ───────────────────────────────────────────
# Same pair goes on the Lightsail box: the worker uploads, the app reads.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux → Settings → Webhooks, after creating the endpoint.
MUX_WEBHOOK_SECRET=
# Which progressive MP4 rendition to play. If clips 404 in the editor, your Mux
# account is on the newer static-renditions API — try 1080p or capped-1080p.
MUX_MP4_RENDITION=high

# ── Remotion → printed by the two deploy commands ────────────────────────────
#   npx remotion lambda functions deploy      → function name
#   npx remotion lambda sites create lib/remotion/index.tsx --site-name=olade
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_AWS_REGION=us-east-1
# A SECOND `openssl rand -hex 32`, different from the one above. Signs the
# render-complete callback.
REMOTION_WEBHOOK_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
# Use test keys (sk_test_/whsec_) until a purchase works end to end.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the two products you created. Each goes in TWICE — the server
# reads one, the buy buttons read the NEXT_PUBLIC_ copy.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD=

# ── Economics and limits (decided already — leave as-is) ─────────────────────
TOKENS_PER_CLIP=400
CLIP_USD_ESTIMATE=2.58
DAILY_SPEND_CEILING_USD=500
MAX_GENERATIONS_PER_HOUR=20
MAX_IMAGES_PER_PROJECT=50
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp
